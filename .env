# Public build-time settings. Safe to commit: the Supabase publishable (anon) key is
# public by design and all access control is enforced by Row-Level Security.
# NEVER put a service_role key, an API secret or a Cloudinary API secret in this file.
#
# While VITE_SUPABASE_URL is blank the site runs in PREVIEW MODE with sample content,
# so the template can be reviewed before the backend exists. See docs/SETUP.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudinary "cloud name" (Dashboard > Settings). Not a secret.
VITE_CLOUDINARY_CLOUD_NAME=
